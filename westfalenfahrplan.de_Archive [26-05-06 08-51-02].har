:\"Großdornberg\",\"type\":\"locality\"},\"properties\":{\"stopId\":\"23005403\"},\"coord\":[52.049198,8.460863],\"niveau\":0},\"productClasses\":[5],\"properties\":{\"AREA_NIVEAU_DIVA\":\"0\",\"areaGid\":\"de:05711:5403\",\"area\":\"0\",\"platform\":\"2\",\"zone\":\"owl:60151\"},\"arrivalTimePlanned\":\"2026-05-09T13:44:00Z\"}]},{\"location\":{\"id\":\"de:05711:5081:71:74\",\"isGlobalId\":true,\"name\":\"Bielefeld, Sieker\",\"disassembledName\":\"Steig D\",\"type\":\"platform\",\"coord\":[52.004953,8.557702],\"properties\":{\"stopId\":\"23005081\",\"area\":\"71\",\"platform\":\"74\",\"platformName\":\"Steig D\",\"plannedPlatformName\":\"Steig D\"},\"parent\":{\"id\":\"de:05711:5081\",\"isGlobalId\":true,\"name\":\"Bielefeld, Sieker\",\"disassembledName\":\"Sieker\",\"type\":\"stop\",\"parent\":{\"id\":\"placeID:5711000:7\",\"name\":\"Bielefeld\",\"type\":\"locality\"},\"properties\":{\"stopId\":\"23005081\"}}},\"departureTimePlanned\":\"2026-05-09T13:32:00Z\",\"departureTimeBaseTimetable\":\"2026-05-09T13:32:00Z\",\"transportation\":{\"id\":\"owl:32024: :H:6_0\",\"name\":\"Stadtbus 24\",\"disassembledName\":\"24\",\"number\":\"24\",\"product\":{\"id\":9,\"class\":5,\"name\":\"Stadtbus\",\"iconId\":3},\"operator\":{\"code\":\"moBiel\",\"id\":\"14\",\"name\":\"moBiel\"},\"destination\":{\"id\":\"23005403\",\"name\":\"BI-Großdornberg, Vulsiekshof\",\"type\":\"stop\"},\"properties\":{\"isSTT\":true,\"tripCode\":135,\"mtSubcode\":\"323\",\"lineDisplay\":\"LINE\",\"globalId\":\"de:NWL:05711|Bus|24:\",\"OperatorURL\":\"www.mobiel.de\"},\"origin\":{\"id\":\"23005081\",\"name\":\"Bielefeld, Sieker\",\"type\":\"stop\"}},\"infos\":[{\"timestamps\":{\"creation\":\"2026-04-27T10:07:00Z\"},\"priority\":\"normal\",\"id\":\"ems-117592\",\"version\":1,\"type\":\"lineInfo\",\"properties\":{\"publisher\":\"ems.comm.addinfo\",\"infoType\":\"lineInfo\",\"incidentDateTime\":\"27/04/2026 12:00 - 16/06/2026 00:00\"},\"infoLinks\":[{\"urlText\":\"BI-Kirchdornberg: Li. 24 - Umleitung Kirchdornberger Str. (29.4-15.6.)\",\"url\":\"https://ems-web.westfalenfahrplan.de/info-link/eb59df56-8b41-5bf8-a5cd-0633f886bb8d\",\"content\":\"<div>\\n<div>Von <strong>Mittwoch, den 29. April bis vsl. Montag, den 15. Juni</strong> wird die <strong>Bus-Linie 24</strong> in Richtung Dornberg an der Kirchdornberger Stra&szlig;e umgeleitet.</div>\\n<div>&nbsp;</div>\\n<div><strong>Folgende Haltestellen entfallen in Richtung Dornberg:</strong></div>\\n<ul>\\n<li>(H) Auf dem Kley</li>\\n<li>(H) Kirchdornberg</li>\\n<li>(H) Sportplatz</li>\\n<li>(H) Gro&szlig;er Kamp</li>\\n<li>(H) Bezirksamt Dornberg</li>\\n</ul>\\n<div><strong>Deine Alternativen:</strong></div>\\n<ul>\\n<li>Ersatzhaltestelle in der Str. Am Arnsberg</li>\\n<li>Ersatzhaltestelle in der Str. Am Sportplatz</li>\\n</ul>\\n<div>Die Umleitung erfolgt &uuml;ber Am Arnsberg, Obernfeld, Am Sportplatz und Wertherstra&szlig;e.</div>\\n<div>Grund f&uuml;r die Umleitung sind Leitungsverlegungen.</div>\\n<div>&nbsp;</div>\\n<div><strong>Downloads:</strong></div>\\n<div><a href=\\\"https://www.mobiel.de/fileadmin/user_upload/Allgemein/Karten_Verkehrsmeldungen/107_24_KirchdornbergerStr.png\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Linie 24: Umleitung an der Kirchdornberger Stra&szlig;e</a></div>\\n</div>\",\"subtitle\":\"BI-Kirchdornberg: Li. 24 - Umleitung Kirchdornberger Str. (29.4-15.6.)\",\"title\":\"BI-Kirchdornberg: Li. 24 - Umleitung Kirchdornberger Str. (29.4-15.6.)\",\"wapText\":\"BI-Kirchdornberg: Li. 24 - Umleitung Kirchdornberger Str. (29.4-15.6.)\",\"smsText\":\"BI-Kirchdornberg: Li. 24 - Umleitung Kirchdornberger Str. (29.4-15.6.)\"}]}],\"onwardLocations\":[{\"isGlobalId\":true,\"id\":\"de:05711:5193:72:72\",\"name\":\"Bielefeld, Lutherkirche\",\"disassembledName\":\"A\",\"type\":\"platform\",\"coord\":[52.010095,8.561556],\"niveau\":0,\"parent\":{\"isGlobalId\":true,\"id\":\"de:05711:5193\",\"name\":\"Bielefeld, Lutherkirche\",\"disassembledName\":\"Lutherkirche\",\"type\":\"stop\",\"parent\":{\"id\":\"p