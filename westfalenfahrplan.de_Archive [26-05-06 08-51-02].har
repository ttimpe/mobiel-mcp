\",\"platformName\":\"Bus 3\",\"plannedPlatformName\":\"Bus 3\",\"accessArray\":[{\"stoppointAccess\":{\"equipment\":0,\"maxWeight\":0,\"distanceTrack\":0,\"lengthAvail\":0,\"widthAvail\":0,\"attributes\":0,\"stepFromStreet\":0}}],\"zone\":\"ddb:;owl:66221;vgm:;vph:66221\"},\"arrivalTimePlanned\":\"2026-05-06T07:25:00Z\",\"arrivalTimeEstimated\":\"2026-05-06T07:25:00Z\"}],\"infos\":[{\"timestamps\":{\"creation\":\"2025-12-15T09:44:00Z\"},\"priority\":\"normal\",\"id\":\"ems-115827\",\"version\":11047439,\"type\":\"lineInfo\",\"properties\":{\"publisher\":\"ems.comm.addinfo\",\"infoType\":\"lineInfo\",\"incidentDateTime\":\"05/01/2026 04:00 - 30/05/2026 00:00\"},\"infoLinks\":[{\"urlText\":\"BI: Hillegossen - Umleitung Alte Detmolder Str. (bis 29.5.)\",\"url\":\"https://ems-web.westfalenfahrplan.de/info-link/473853d3-0605-5bee-a326-b32ef8cfdf38\",\"content\":\"<div><strong>Umleitung Alte Detmolder Stra&szlig;e ge&auml;ndert</strong></div>\\n<div>&nbsp;</div>\\n<div>Bis vsl. 29. Mai werden die Bus-Linien 32, 38, 127, 131, 138 und N5 an der Alten Detmolder Stra&szlig;e weiter umgeleitet. <strong>Beachte, dass die Umleitung ab Mittwoch, 22. April ca. 9:30 Uhr nur noch stadtausw&auml;rts erfolgt!</strong></div>\\n<div>&nbsp;</div>\\n<div><strong>Folgende Haltestellen entfallen:</strong></div>\\n<ul>\\n<li>(H) Nesselstra&szlig;e</li>\\n<li>(H) An der Wesebreede</li>\\n</ul>\\n<div>&nbsp;</div>\\n<div><strong>Deine Alternativen:</strong></div>\\n<ul>\\n<li>Ersatzhaltestellen in der Detmolder Stra&szlig;e (siehe Skizze)</li>\\n</ul>\\n<div><strong>Downloads:</strong></div>\\n<div><a href=\\\"https://www.mobiel.de/fileadmin/user_upload/Allgemein/Karten_Verkehrsmeldungen/084_32_38_127_131_138_N5_AlteDetmolder.png\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Linien 32, 38, 127, 131, 138, N5: Umleitung Alte Detmolder Stra&szlig;</a></div>\",\"subtitle\":\"BI: Hillegossen - Umleitung Alte Detmolder Str. (bis 29.5.)\",\"title\":\"BI: Hillegossen - Umleitung Alte Detmolder Str. (bis 29.5.)\",\"wapText\":\"BI: Hillegossen - Umleitung Alte Detmolder Str. (bis 29.5.)\",\"smsText\":\"BI: Hillegossen - Umleitung Alte Detmolder Str. (bis 29.5.)\"}]},{\"timestamps\":{\"creation\":\"2025-01-08T13:31:00Z\"},\"priority\":\"normal\",\"id\":\"ems-111769\",\"version\":17436082,\"type\":\"lineInfo\",\"properties\":{\"publisher\":\"ems.comm.addinfo\",\"infoType\":\"lineInfo\",\"incidentDateTime\":\"08/01/2025 14:00 - 31/12/2500 01:00\"},\"infoLinks\":[{\"urlText\":\"BI: Linie 38 - Neue Umleitung an der Detmolder Straße\",\"url\":\"https://ems-web.westfalenfahrplan.de/info-link/e0c73973-532d-5688-9516-335e78900730\",\"content\":\"<div>\\n<div><strong>Oerlinghausen: Umleitung an der Detmolder Stra&szlig;e</strong></div>\\n<div>&nbsp;</div>\\n<div>Ab&nbsp;Dienstag, 17. Dezember&nbsp;wird die&nbsp;Bus-Linie 38&nbsp;an der Detmolder Stra&szlig;e bis auf Weiteres umgeleitet.</div>\\n<div>&nbsp;</div>\\n<div><strong>Folgende Haltestellen entfallen in Richtung Stieghorst:</strong></div>\\n<ul>\\n<li>(H) Rollkrug</li>\\n<li>(H) Carolinen Quelle</li>\\n</ul>\\n<div><strong>Deine Alternativen:</strong></div>\\n<div>Alle Haltestellen auf der Umleitungsstrecke werden mitbedient.</div>\\n<div>&nbsp;</div>\\n<div>In Richtung Oerlinghausen Bahnhof erfolgt die Umleitung &uuml;ber die Abfahrt zur B66.</div>\\n<div>&nbsp;</div>\\n<div><strong>Download:</strong><br /><a href=\\\"https://www.mobiel.de/fileadmin/user_upload/Allgemein/Karten_Verkehrsmeldungen/398_38_B66.PNG\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Linie 38 &ndash; Umleitung Detmolder Stra&szlig;e</a></div>\\n</div>\",\"subtitle\":\"BI: Linie 38 - Neue Umleitung an der Detmolder Straße\",\"title\":\"BI: Linie 38 - Neue Umleitung an der Detmolder Straße\",\"wapText\":\"BI: Linie 38 - Neue Umleitung an der Detmolder Straße\",\"smsText\":\"BI: Linie 38 - Neue Umleitung an der Detmolder Straße\"}]}],\"coords\":[[52.001093,8.589384,{\"d\":0.0}],[52.001201,8.589389,{\"d\":12.1}],[52.001323,8.58939,{\"d\":13.53}