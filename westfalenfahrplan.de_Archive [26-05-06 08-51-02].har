"},\"coord\":[52.049198,8.460863],\"niveau\":0},\"productClasses\":[5],\"properties\":{\"AREA_NIVEAU_DIVA\":\"0\",\"areaGid\":\"de:05711:5403\",\"area\":\"0\",\"platform\":\"2\",\"zone\":\"owl:60151\"},\"arrivalTimePlanned\":\"2026-05-06T07:44:00Z\"}]},{\"realtimeStatus\":[\"MONITORED\"],\"isRealtimeControlled\":true,\"location\":{\"id\":\"de:05711:5081:71:73\",\"isGlobalId\":true,\"name\":\"Bielefeld, Sieker\",\"disassembledName\":\"Steig C\",\"type\":\"platform\",\"coord\":[52.004897,8.558043],\"properties\":{\"stopId\":\"23005081\",\"area\":\"71\",\"platform\":\"73\",\"platformName\":\"Steig C\",\"plannedPlatformName\":\"Steig C\"},\"parent\":{\"id\":\"de:05711:5081\",\"isGlobalId\":true,\"name\":\"Bielefeld, Sieker\",\"disassembledName\":\"Sieker\",\"type\":\"stop\",\"parent\":{\"id\":\"placeID:5711000:7\",\"name\":\"Bielefeld\",\"type\":\"locality\"},\"properties\":{\"stopId\":\"23005081\"}}},\"departureTimePlanned\":\"2026-05-06T07:02:00Z\",\"departureTimeBaseTimetable\":\"2026-05-06T07:02:00Z\",\"departureTimeEstimated\":\"2026-05-06T07:02:00Z\",\"transportation\":{\"id\":\"owl:32032: :H:6_0\",\"name\":\"Stadtbus 32\",\"disassembledName\":\"32\",\"number\":\"32\",\"product\":{\"id\":9,\"class\":5,\"name\":\"Stadtbus\",\"iconId\":3},\"operator\":{\"code\":\"moBiel\",\"id\":\"14\",\"name\":\"moBiel\"},\"destination\":{\"id\":\"23005323\",\"name\":\"Bielefeld, Stieghorst\",\"type\":\"stop\"},\"properties\":{\"isSTT\":true,\"tripCode\":52,\"mtSubcode\":\"323\",\"lineDisplay\":\"LINE\",\"globalId\":\"de:NWL:05711|Bus|32:\",\"OperatorURL\":\"www.mobiel.de\"},\"origin\":{\"id\":\"23005081\",\"name\":\"Bielefeld, Sieker\",\"type\":\"stop\"}},\"infos\":[{\"timestamps\":{\"creation\":\"2025-12-15T09:44:00Z\"},\"priority\":\"normal\",\"id\":\"ems-115827\",\"version\":11047439,\"type\":\"lineInfo\",\"properties\":{\"publisher\":\"ems.comm.addinfo\",\"infoType\":\"lineInfo\",\"incidentDateTime\":\"05/01/2026 04:00 - 30/05/2026 00:00\"},\"infoLinks\":[{\"urlText\":\"BI: Hillegossen - Umleitung Alte Detmolder Str. (bis 29.5.)\",\"url\":\"https://ems-web.westfalenfahrplan.de/info-link/473853d3-0605-5bee-a326-b32ef8cfdf38\",\"content\":\"<div><strong>Umleitung Alte Detmolder Stra&szlig;e ge&auml;ndert</strong></div>\\n<div>&nbsp;</div>\\n<div>Bis vsl. 29. Mai werden die Bus-Linien 32, 38, 127, 131, 138 und N5 an der Alten Detmolder Stra&szlig;e weiter umgeleitet. <strong>Beachte, dass die Umleitung ab Mittwoch, 22. April ca. 9:30 Uhr nur noch stadtausw&auml;rts erfolgt!</strong></div>\\n<div>&nbsp;</div>\\n<div><strong>Folgende Haltestellen entfallen:</strong></div>\\n<ul>\\n<li>(H) Nesselstra&szlig;e</li>\\n<li>(H) An der Wesebreede</li>\\n</ul>\\n<div>&nbsp;</div>\\n<div><strong>Deine Alternativen:</strong></div>\\n<ul>\\n<li>Ersatzhaltestellen in der Detmolder Stra&szlig;e (siehe Skizze)</li>\\n</ul>\\n<div><strong>Downloads:</strong></div>\\n<div><a href=\\\"https://www.mobiel.de/fileadmin/user_upload/Allgemein/Karten_Verkehrsmeldungen/084_32_38_127_131_138_N5_AlteDetmolder.png\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\">Linien 32, 38, 127, 131, 138, N5: Umleitung Alte Detmolder Stra&szlig;</a></div>\",\"subtitle\":\"BI: Hillegossen - Umleitung Alte Detmolder Str. (bis 29.5.)\",\"title\":\"BI: Hillegossen - Umleitung Alte Detmolder Str. (bis 29.5.)\",\"wapText\":\"BI: Hillegossen - Umleitung Alte Detmolder Str. (bis 29.5.)\",\"smsText\":\"BI: Hillegossen - Umleitung Alte Detmolder Str. (bis 29.5.)\"}]}],\"onwardLocations\":[{\"isGlobalId\":true,\"id\":\"de:05711:5172:0:2\",\"name\":\"Bielefeld, Osningschule\",\"disassembledName\":\"Osningschule\",\"type\":\"platform\",\"coord\":[52.001905,8.560864],\"niveau\":0,\"parent\":{\"isGlobalId\":true,\"id\":\"de:05711:5172\",\"name\":\"Bielefeld, Osningschule\",\"disassembledName\":\"Osningschule\",\"type\":\"stop\",\"parent\":{\"id\":\"placeID:5711000:7\",\"name\":\"Bielefeld\",\"type\":\"locality\"},\"properties\":{\"stopId\":\"23005172\"},\"coord\":[52.002016,8.560783],\"niveau\":0},\