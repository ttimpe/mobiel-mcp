dorf, Jahnplatz, (H) Bad Sassendorf, Wilhelmstr., (H) Bad Sassendorf, Hof Haulle und (H) Bad Sassendorf, Thermalbad - Grund: Baumaßnahme\",\"source\":{\"id\":\"NWL-PROD-EMS\",\"name\":\"NWL-PROD-EMS\",\"type\":\"Produktiv EMS\"},\"MessageType\":\"planned\",\"PS\":\"\\\"\\\"\",\"producerRef\":\"NWL\",\"deviceRef\":\"90c5ffc296ae4988a3f121a28b08ea6a\",\"messageRef\":\"557bde77-a86a-52d3-8208-3a863f7a0928\",\"eventRef\":\"ba5420acc49ffa46d4cb8493095dd8a4\",\"EquipmentReason\":\"constructionWork\",\"publisher\":\"ems.comm.addinfo\",\"incidentDateTime\":\"10/04/2026 12:00 - 31/12/2500 01:00\",\"providerCode\":\"NWL\"},\"affected\":{\"lines\":[{\"id\":\"vgm:92081: :H:\",\"destination\":{\"name\":\"Lohne, Lohner Klei Westerklei\",\"type\":\"stop\"},\"name\":\"RegioBus R81\",\"number\":\"R81\",\"description\":\"Bördebus Soest - Bad Sassendorf - Lohne\",\"product\":{\"id\":11,\"class\":6,\"iconId\":3},\"operator\":{\"id\":\"08\",\"name\":\"WB Westfalen Bus GmbH\"}},{\"id\":\"vgm:92081: :R:\",\"destination\":{\"name\":\"Soest, Schulzentrum\",\"type\":\"stop\"},\"name\":\"RegioBus R81\",\"number\":\"R81\",\"description\":\"Bördebus Lohne - Bad Sassendorf - Soest\",\"product\":{\"id\":11,\"class\":6,\"iconId\":3},\"operator\":{\"id\":\"08\",\"name\":\"WB Westfalen Bus GmbH\"}}],\"stops\":[{\"id\":\"de:05974:62047\",\"isGlobalId\":true,\"name\":\"Bad Sassendorf, Sassendorf, Jahnplatz\",\"type\":\"stop\",\"parent\":{\"id\":\"placeID:5974008:1\",\"name\":\"Bad Sassendorf\",\"type\":\"locality\"},\"properties\":{\"stopId\":\"24062047\"}},{\"id\":\"de:05974:21888\",\"isGlobalId\":true,\"name\":\"Bad Sassendorf, Wilhelmstr.\",\"type\":\"stop\",\"parent\":{\"id\":\"placeID:5974008:1\",\"name\":\"Bad Sassendorf\",\"type\":\"locality\"},\"properties\":{\"stopId\":\"24021888\"}},{\"id\":\"de:05974:60858\",\"isGlobalId\":true,\"name\":\"Bad Sassendorf, Hof Haulle\",\"type\":\"stop\",\"parent\":{\"id\":\"placeID:5974008:1\",\"name\":\"Bad Sassendorf\",\"type\":\"locality\"},\"properties\":