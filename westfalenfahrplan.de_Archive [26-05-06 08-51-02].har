            "text": "{\"serverInfo\":{\"controllerVersion\":\"10.6.31.7\",\"serverID\":\"WFP-EFA02-P\",\"virtDir\":\"nwl-efa\",\"serverTime\":\"2026-05-06T08:50:31\",\"calcTime\":20.895,\"logRequestId\":\"218e0426131a605f\"},\"version\":\"11.0.6.72\",\"timestamp\":\"2026-05-06T06:50:31Z\",\"infos\":{\"current\":[{\"type\":\"stopInfo\",\"id\":\"ems-117387\",\"version\":1,\"priority\":\"high\",\"timestamps\":{\"creation\":\"2026-04-10T10:41:00Z\",\"availability\":{\"from\":\"2026-04-10T10:00:00Z\",\"isOpenEnd\":true},\"validity\":[{\"from\":\"2026-04-10T10:00:00Z\",\"isOpenEnd\":true}],\"expiration\":\"2500-12-31T00:00:59Z\"},\"infoLinks\":[{\"urlText\":\"Bad Sassendorf: Haltestellenausfall durch Baumaßnahme\",\"url\":\"https://ems-web.westfalenfahrplan.de/info-link/557bde77-a86a-52d3-8208-3a863f7a0928\",\"content\":\"<b>Linie<b> R81 </b>: </b>An den <b>(H) Bad Sassendorf, Sassendorf, Jahnplatz, (H) Bad Sassendorf, Wilhelmstr., (H) Bad Sassendorf, Hof Haulle</b> und <b>(H) Bad Sassendorf, Thermalbad</b> kommt es zu <b>einem Haltestellenausfall</b>.<br><br> Dauer: Bis auf Weiteres<br><br>Die Haltestelle wird nicht angefahren. Die Haltestellen Wilhelmstraße und Thermalbad werden nur um 7:08 Uhr und 7:09 Uhr bedient. Die Haltestellen Jahnstraße, Wilhelmstraße, Hof Haule und Thermalbad werden sonst von der R81, nicht mehr bedient.\\nFür die Haltestellen Thermalbad und Wilhelmstraße nutzen Sie bitte die Haltestelle Gartenstraße als Ersatz.\\nFür die Haltestellen Hof Haule und Jahnplatz, nutzen Sie bitte die Ersatzhaltestelle im Lohweg.\",\"subtitle\":\"Bad Sassendorf: Haltestellenausfall durch Baumaßnahme\",\"title\":\"Bad Sassendorf: Haltestellenausfall durch Baumaßnahme\",\"smsText\":\"Linie R81 : Haltestellenausfall - (H) Bad Sassendorf, Sassendorf, Jahnplatz, (H) Bad Sassendorf, Wilhelmstr., (H) Bad Sassendorf, Hof Haulle und (H) Bad Sassendorf, Thermalbad - Grund: Baumaßnahme\"}],\"properties\":{\"wmlText\":\"Linie R81 : Haltestellenausfall - (H) Bad Sassendorf, Sassendorf, Jahnplatz, (H) Bad Sassendorf, Wilhelmstr., (H) Bad Sassendorf, Hof Haulle und (H) Bad Sassendorf, Thermalbad - Grund: Baumaßnahme\",\"source\":{\"id\":\"NWL-PROD-EMS\",\"name\":\"NWL-PROD-EMS\",\"type\":\"Produktiv EMS\"},\"MessageType\":\"planned\",\"PS\":\"\\\"\\\"\",\"producerRef\":\"NWL\",\"deviceRef\":\"90c5ffc296ae4988a3f121a28b08ea6a\",\"messageRef\":\"557bde77-a86a-52d3-8208-3a863f7a0928\",\"eventRef\":\"ba5420acc49ffa46d4cb8493095dd8a4\",\"EquipmentReason\":\"constructionWork\",\"publisher\":\"ems.comm.addinfo\",\"incidentDateTime\":\"10/04/2026 12:00 - 31/12/2500 01:00\",\"providerCode\":\"NWL\"},\"affected\":{\"lines\":[{\"id\":\"vgm:92081: :H:\",\"destination\":{\"name\":\"Lohne, Lohner Klei Westerklei\",\"type\":\"stop\"},\"name\":\"RegioBus R81\",\"number\":\"R81\",\"description\":\"Bördebus Soest - Bad Sassendorf - Lohne\",\"product\":{\"id\":11,\"class\":6,\"iconId\":3},\"operator\":{\"id\":\"08\",\"name\":\"WB Westfalen Bus GmbH\"}},{\"id\":\"vgm:92081: :R:\",\"destination\":{\"name\":\"Soest, Schulzentrum\",\"type\":\"stop\"},\"name\":\"RegioBus R81\",\"number\":\"R81\",\"description\":\"Bördebus Lohne - Bad Sassendorf - Soest\",\"product\":{\"id\":11,\"class\":6,\"iconId\":3},\"operator\":{\"id\":\"08\",\"name\":\"WB Westfalen Bus GmbH\"}}],\"stops\":[{\"id\":\"de:05974:62047\",\"isGlobalId\":true,\"name\":\"Bad Sassendorf, Sassendorf, Jahnplatz\",\"type\":\"stop\",\"parent\":{\"id\":\"placeID:5974008:1\",\"name\":\"Bad Sassendorf\",\"type\":\"locality\"},\"properties\":{\"stopId\":\"24062047\"}},{\"id\":\"de:05974:21888\",\"isGlobalId\":true,\"name\":\"Bad Sassendorf, Wilhelmstr.\",\"type\":\"stop\",\"parent\":{\"id\":\"placeID:5974008:1\",\"name\":\"Bad Sassendorf\",\"type\":\"locality\"},\"properties\":{\"stopId\":\"24021888\"}},{\"id\":\"de:05974:60858\",\"isGlobalId\":true,\"name\":\"Bad Sassendorf, Hof Haulle\",\"type\":\"stop\",\"parent\":{\"id\":\"placeID:5974008:1\",\"name\":\"Bad Sassendorf\",\"type\":\"locality\"},\"properties\"